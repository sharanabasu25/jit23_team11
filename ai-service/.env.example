# Server configuration
HOST=0.0.0.0
PORT=8001
ENV=development

# Application settings
APP_NAME="Smart Public Grievance Management System - AI Service"
API_VERSION=1.0

# YOLO configuration
YOLO_CONFIDENCE_THRESHOLD=0.15

# Gemini Vision API (fallback for low-confidence detections)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_ENABLED=true
